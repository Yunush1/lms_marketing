# ─── Backend API ─────────────────────────────────────────────────────────
# Server-side base URL used by `lib/api.ts` (server components + ISR fetches).
# Point this at the NestJS API root including the /api/v1 prefix.
API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL_PUBLIC=https://lmsapi.chugalakhor.com/api/v1/
# ─── Public site origin ──────────────────────────────────────────────────
# Used for canonical URLs and absolute OG/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://edusphere.app

# ─── Authenticated app (the existing React SPA) ──────────────────────────
# The header's "Sign in" / "Start free" buttons link here.
NEXT_PUBLIC_APP_URL=https://app.edusphere.app
